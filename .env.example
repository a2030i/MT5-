# ============================================
# منصة مُرشد - متغيرات البيئة
# ============================================
# انسخ هذا الملف إلى .env واملأ القيم

# --- الأمان (مطلوب) ---
# مفتاح JWT - استخدم: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars

# مفتاح التشفير لبيانات MT5 - استخدم نفس الأمر أعلاه
ENCRYPTION_KEY=change-this-encryption-key-for-mt5-passwords

# --- قاعدة البيانات ---
DATABASE_URL=postgresql+asyncpg://mursheed:mursheed@db:5432/mursheed

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- MetaApi (مهم جداً) ---
# سجل في https://metaapi.cloud واحصل على token مجاناً
METAAPI_TOKEN=

# --- إعدادات عامة ---
DEBUG=True
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Frontend ---
VITE_API_URL=http://localhost:8000/api
